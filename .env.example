# AG2R Configuration

# Server
PORT=3000

# CDP (Chrome DevTools Protocol)
CDP_HOST=127.0.0.1
CDP_PORT=9000

# Authentication
# AUTH_ENABLED=false means no login required. The ag2r() shell function
# overrides with AUTH_ENABLED=true for production/tunnel access.
# 
# SECURITY NOTE: On first run without APP_PASSWORD set, a cryptographically
# secure random password is generated and printed to the console.
# For production/tunnel use, ALWAYS set a strong custom password below.
AUTH_ENABLED=false
APP_PASSWORD=
SESSION_SECRET=

# Polling
POLL_INTERVAL_MS=500

# Tunnel (Cloudflare Tunnel)
TUNNEL_ENABLED=false
TUNNEL_URL=https://remote.yourdomain.com

# Security
# Rate limiting (requests per minute per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Debug mode (disable in production)
# WARNING: Enables /eval endpoint - DO NOT use with tunnel/prod
DEBUG_MODE=false
