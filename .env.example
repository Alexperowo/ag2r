# AG2R Configuration

# Server
PORT=3000

# CDP (Chrome DevTools Protocol)
CDP_HOST=127.0.0.1
CDP_PORT=9000

# Authentication
# Authentication is enabled by default. The setup creates private values.
# Leave APP_PASSWORD empty to receive a temporary six-digit passcode at startup.
AUTH_ENABLED=true
APP_PASSWORD=
SESSION_SECRET=

# Linux only: set this when Antigravity is not available in PATH or a standard location.
# ANTIGRAVITY_BIN=/opt/Antigravity/antigravity

# Polling
POLL_INTERVAL_MS=500

# Tunnel (Cloudflare Tunnel)
TUNNEL_ENABLED=false
TUNNEL_URL=https://remote.yourdomain.com

# Development only. Keep false for normal encrypted local-network access.
HTTP_ONLY=false
