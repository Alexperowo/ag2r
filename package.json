{
  "name": "ag2r",
  "version": "1.1.0",
  "private": true,
  "description": "Accessible mobile remote interface for local Antigravity IDE sessions.",
  "engines": {
    "node": ">=22.11.0"
  },
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check:syntax": "node scripts/check-syntax.js",
    "test": "node --test",
    "check": "npm run check:syntax && npm test",
    "smoke:local": "node scripts/smoke-local.js"
  },
  "keywords": [
    "antigravity",
    "remote",
    "cdp",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "chrome-remote-interface": "^0.33.2",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  }
}
